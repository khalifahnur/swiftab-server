# --- Required ---------------------------------------------------------------
MONGODB_CONN=mongodb+srv://user:password@cluster.example.mongodb.net
JWT_SECRET=replace-with-a-long-random-string
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional (defaults shown) ----------------------------------------------
PORT=8080
MONGODB_DB=test
# "production" (default) or "development". Development relaxes CORS and sets
# a host-only, non-secure session cookie so the dashboard works on localhost.
APP_ENV=production
# Extra browser origins allowed to call the API, comma separated.
# https://swiftab.co.ke and https://www.swiftab.co.ke are always allowed.
ALLOWED_ORIGIN=
# Domain for the dashboard session cookie in production.
COOKIE_DOMAIN=.swiftab.co.ke
# Timezone used for "today", daily reports and reservation dates.
APP_TIMEZONE=Africa/Nairobi
# Set to true once the app builds that send login tokens are released; until
# then requests without a token are still accepted from the mobile apps.
REQUIRE_MOBILE_AUTH=false

# --- Email (optional) -------------------------------------------------------
# Without SMTP, waiter invite codes are only shown in the dashboard and
# diners cannot reset a forgotten password by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
